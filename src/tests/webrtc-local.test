#!/bin/sh

# Loopback mosh session through the WebRTC bridge (no ssh, no docker).
# Skipped when the binaries were built without --enable-webrtc.

. "$(dirname "$0")/e2e-test-subrs"
if ! set_locale; then
    echo "$0: no usable locale" >&2
    exit 99
fi
if ! grep -q '^#define HAVE_WEBRTC 1' ../include/config.h; then
    echo "$0: built without --enable-webrtc, skipping" >&2
    exit 77
fi

set -eu
exec python3 "$srcdir/webrtc-local-smoke.py" \
    --server=../frontend/mosh-server --client=../frontend/mosh-client
